{
  "manifest_version": 3,
  "name": "Duels de l'IA",
  "version": "1.3.0",
  "description": "Extension pour l'atelier pédagogique Duel de l'IA",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.comparia.beta.gouv.fr/*",
        "*://comparia.beta.gouv.fr/*",
        "http://localhost/*",
        "http://localhost:*/*"
      ],
      "js": [
        "js/content-redesign.js"
      ],
      "css": [
        "css/new-styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/new-styles.css",
        "data/content-data.json",
        "data/qr_code_transparent_fixed.png",
        "data/slides/*",
        "fonts/*"
      ],
      "matches": [
        "*://*.comparia.beta.gouv.fr/*",
        "*://comparia.beta.gouv.fr/*",
        "http://localhost/*",
        "http://localhost:*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
